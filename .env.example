PORT=7420
AUTH_TOKEN=changeme-REQUIRED
ROOT_DIR=/home/kay2
OLLAMA_URL=http://127.0.0.1:11434

# Host identity (pi | vps) — shown in app, used for failover UX
HOST_ROLE=pi
HOST_NAME=kay2

# Pi only: VPS project sync target (Tailscale SSH)
# VPS_SYNC_TARGET=kay2@stan-vps

# VPS only: enable OpenClaw in agent list
# OPENCLAW_ENABLED=1

# vast.ai GPU burst — https://cloud.vast.ai/manage-keys/
# VAST_API_KEY=
# VAST_MAX_DPH=0.55
# VAST_MIN_GPU_RAM_MB=16384
# VAST_OLLAMA_MODEL=gemma2:9b
# VAST_GPU_LABEL=stan-gpu
# TAILSCALE_AUTHKEY=tskey-auth-...   # auto-join GPU box to tailnet

# Optional: allow Health panel to enable/disable Tailscale without a password.
# See docs/pi-recovery.md for sudoers snippet.
