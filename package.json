{
  "name": "stan-cli",
  "version": "1.0.0",
  "description": "Self-hosted Pi remote panel — terminal, files, AI. No relay, no cloud.",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev":     "node server/index.js",
    "start":   "pm2 start ecosystem.config.js",
    "stop":    "pm2 stop stan-cli",
    "restart": "pm2 restart stan-cli",
    "logs":    "pm2 logs stan-cli",
    "status":  "pm2 status",
    "tunnel":  "pm2 start ecosystem.config.js --only stan-cli-tunnel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kay2stack/KAY2Tunnel.git"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "node-pty": "^1.0.0",
    "ws": "^8.15.1"
  }
}
