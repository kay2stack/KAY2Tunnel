{
  "name": "stan-cli",
  "version": "0.1.0",
  "description": "Your terminal companion.",
  "main": "server/index.js",
  "scripts": {
    "dev": "node server/index.js",
    "build": "bash scripts/build.sh",
    "start": "pm2 start ecosystem.config.js",
